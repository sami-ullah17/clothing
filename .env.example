# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ====================================================
# PRI-BOUTIQUE AUTOMATED ENVIRONMENT CONFIGURATION
# ====================================================

# 1. Frontend API URL
VITE_API_URL=""

# 2. Cloudinary CDN Image Storage
CLOUDINARY_URL=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CLOUD_NAME=""

# 3. Supabase Permanent Database & Bucket Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. Optional PostgreSQL Connection (Neon / Supabase Postgres / Railway)
DATABASE_URL=""

# 5. Boutique Administration & Security
ADMIN_EMAIL="admin@pri-buteeq.com"
ADMIN_PASSWORD="admin123"
JWT_SECRET="pri-buteeq-jwt-secret-key-2026-fashion-store"
