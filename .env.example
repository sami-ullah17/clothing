# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ====================================================
# PRI-BOUTIQUE AUTOMATED ENVIRONMENT CONFIGURATION
# پرائی بوتیک آن لائن کلاؤڈ و امیج اسٹوریج کنفیگریشن
# ====================================================

# 1. فرنٹ اینڈ API بیس یو آر ایل
# خودکار: خالی چھوڑیں تاکہ موجودہ ڈومین پر خود بخود چلے، یا اپنی کسٹم لائیو ڈومین درج کریں
VITE_API_URL=""

# 2. کلاؤڈ نری آن لائن امیج اسٹوریج (Cloudinary Permanent CDN)
# اگر آپ کے پاس Cloudinary اکاؤنٹ ہے تو یہاں کیز درج کریں، ورنہ ہمارا خودکار ان-بلٹ پرماننٹ سسٹم ہر تصویر کو لائیو رکھے گا
CLOUDINARY_URL=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CLOUD_NAME=""

# 3. سپابیس کلاؤڈ ڈیٹا بیس اور بکٹ اسٹوریج (Supabase Cloud Storage & DB)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. آپشنل پوسٹ گریس ڈیٹا بیس (Supabase Postgres / Neon / Railway)
DATABASE_URL=""

# 5. بوتیک ایڈمن سیکیورٹی اور پاس ورڈ
ADMIN_EMAIL="admin@pri-buteeq.com"
ADMIN_PASSWORD="admin123"
JWT_SECRET="pri-buteeq-jwt-secret-key-2026-fashion-store"

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
