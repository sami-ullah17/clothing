# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Owner / Admin Dashboard Credentials & Security
ADMIN_EMAIL="admin@pri-buteeq.com"
ADMIN_PASSWORD="admin123"
JWT_SECRET="pri-buteeq-jwt-secret-key-2026-fashion-store"

# ====================================================
# PERMANENT PRODUCTION DATABASE (Optional)
# If left empty, Pri-Boutique uses the local permanent
# database at data/database.json with atomic writes.
# ====================================================
# PostgreSQL (Neon, Railway, Supabase PostgreSQL pool, Render):
DATABASE_URL=
# Or POSTGRES_URL=

# Supabase REST Database & Storage:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ====================================================
# PERMANENT IMAGE STORAGE (Optional)
# If left empty, images are stored in public/uploads/
# ====================================================
# Cloudinary CDN Image Hosting:
CLOUDINARY_URL=
# Or:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ====================================================
# FRONTEND API PROXY (For separate Netlify/Vercel deploys)
# ====================================================
# If frontend is deployed on Netlify/Vercel separately from backend:
VITE_API_URL=

