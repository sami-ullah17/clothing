# ====================================================
# PRI-BOUTIQUE ENVIRONMENT CONFIGURATION
# ====================================================

# 1. FRONTEND API BASE URL (Optional)
# Automatic: If left empty, the application automatically uses relative /api on the current website origin.
# Only specify if your backend is hosted on a separate external domain (e.g. https://api.my-domain.com).
VITE_API_URL=

# 2. CLOUDINARY PERMANENT CDN STORAGE (Optional)
# If provided, product images are automatically uploaded to Cloudinary CDN.
# If omitted, the application seamlessly uses the built-in persistent local storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# 3. SUPABASE CLOUD DATABASE & STORAGE (Optional)
# If provided on the backend, Supabase is used automatically.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the browser or frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 4. POSTGRESQL DATABASE (Optional)
# PostgreSQL connection string (Supabase Postgres, Neon, Railway, RDS, etc.).
# If omitted, the application uses the built-in local JSON database (data/database.json).
DATABASE_URL=

# 5. SERVER RUNTIME & SECURITY (Optional / Server-side only)
PORT=3000
NODE_ENV=production
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
